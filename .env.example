# Copy to .env and fill in. Every value is optional.

# ── AI provider ──────────────────────────────────────────────
# auto  = use the API when a key is set, otherwise local models (default)
# api   = always use the hosted API
# local = always use local models (pip install -r requirements-local.txt)
AI_PROVIDER=auto

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Any OpenAI-compatible API also works, e.g. OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# TRANSCRIPTION_MODEL=whisper-1
LLM_MODEL=openai/gpt-oss-120b
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Local mode only: tiny | base | small | medium | large
WHISPER_MODEL=base

# ── Server ───────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from another domain
# (only needed if the frontend is hosted separately, e.g. on Vercel)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=100
MAX_CONCURRENT_JOBS=2
UPLOADS_PER_HOUR=10
JOB_TTL_HOURS=48
